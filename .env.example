# Shared development database. Replace every uppercase placeholder locally.
# For Render, point DATABASE_URL at your Neon Postgres connection string.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# Private per environment. Generate a long random value and never commit it.
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend and CORS locations for local development.
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# Render sets this automatically in production; it enables startup table creation.
RENDER_SERVICE_ID=

# Single-use password reset link lifetime.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Gemini AI categorization.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Recommended provider from the mentor setup: Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=MoneyMate

# Optional Gmail SMTP alternative. Set EMAIL_PROVIDER=smtp to use these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_app_email@gmail.com
SMTP_PASSWORD=replace_with_your_google_app_password
SMTP_FROM_EMAIL=your_app_email@gmail.com
SMTP_FROM_NAME=MoneyMate
SMTP_USE_TLS=true
